{
  "name": "bobby",
  "private": true,
  "version": "0.1.37",
  "type": "module",
  "description": "bobby — animated SVG avatar recreation with customizable shapes, expressions, and colors.",
  "license": "MIT",
  "author": "Emir Lima Neto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emireln/bobby.git"
  },
  "keywords": [
    "svg",
    "animation",
    "avatar",
    "vue",
    "morphing"
  ],
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bump": "node scripts/bump-version.js",
    "assets": "tsx scripts/build_assets.ts",
    "electron:dev": "concurrently -k -s first \"vite --port 5190\" \"tsx scripts/run-electron.ts\"",
    "electron:build": "vue-tsc --noEmit && vite build && tsx scripts/build_assets.ts && tsx scripts/build-electron.ts && electron-packager . Bobby --platform=win32 --arch=x64 --out=dist_app --icon=build/icon.ico --overwrite && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --prepackaged=dist_app/Bobby-win32-x64 --win nsis"
  },
  "build": {
    "appId": "com.emireln.bobby",
    "productName": "Bobby",
    "publish": [
      {
        "provider": "github",
        "owner": "emireln",
        "repo": "bobby"
      }
    ],
    "directories": {
      "output": "dist_electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bobby",
      "artifactName": "Bobby-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Graphics"
    }
  },
  "dependencies": {
    "@respeak/lucide-motion-vue": "^0.6.2",
    "electron-updater": "^6.8.9",
    "mediabunny": "^1.54.0",
    "motion-v": "^2.4.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
